{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yarn Product Schema",
  "type": "object",
  "required": [
    "brand",
    "line_name",
    "weight_category",
    "put_up",
    "recommended_gauge",
    "fiber_content"
  ],
  "properties": {
    "brand": {
      "type": "string"
    },
    "line_name": {
      "type": "string"
    },
    "weight_category": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "description": "Craft Yarn Council (CYC) Standard Weight System (0: Lace to 7: Jumbo)"
    },
    "put_up": {
      "type": "object",
      "required": [
        "weight_grams",
        "weight_ounces",
        "yardage",
        "meters"
      ],
      "properties": {
        "weight_grams": {
          "type": "number",
          "minimum": 0
        },
        "weight_ounces": {
          "type": "number",
          "minimum": 0
        },
        "yardage": {
          "type": "number",
          "minimum": 0
        },
        "meters": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "recommended_gauge": {
      "type": "object",
      "required": [
        "knit_gauge_4in",
        "crochet_gauge_4in",
        "recommended_needle_mm",
        "recommended_hook_mm"
      ],
      "properties": {
        "knit_gauge_4in": {
          "type": "number",
          "minimum": 0
        },
        "crochet_gauge_4in": {
          "type": "number",
          "minimum": 0
        },
        "recommended_needle_mm": {
          "type": "number",
          "minimum": 0
        },
        "recommended_hook_mm": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "fiber_content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fiber_type",
          "percentage"
        ],
        "properties": {
          "fiber_type": {
            "type": "string"
          },
          "percentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
